public function resendEmailVerification(Request $request)
    {
        $user = $request->user();

        if (!$user) {
            return response()->json([
                'status' => false,
                'message' => 'Unauthenticated.',
            ], 401);
        }

        if ($user->email_verified_at) {
            return response()->json([
                'status' => false,
                'message' => 'Email is already verified.',
            ], 400);
        }

        // Generate OTP
        $emailOtp = str_pad(random_int(0, 999999), 6, '0', STR_PAD_LEFT); // always 6 digits

        // Save OTP
        $user->email_otp = $emailOtp;
        $user->save();


        $mailData = [
            'title' => 'Candidate Email Verification',
            'body' => 'This is for testing email using smtp.',
            'url' => URL('api/candidate/email/verify/' . $user->id . '/' . sha1($user->getEmailForVerification())),
            'email' => $user->email,
            'emailOtp' => $emailOtp
        ];

        // Send verification email
        Mail::to($user->email)->send(new VerificationMail($mailData));

        return response()->json([
            'status' => true,
            'message' => 'Verification OTP sent successfully.',
        ]);
    }
